int x, y;

void main() {
    int z, w, r;

    x = 1;
    y = 2;
    z = 3;
    w = 4;

    // local var + local var
    r = z + w;

    // local var + global var
    r = z + x;

    // local var + const
    r = z + 4;

    // global var + local var
    r = x + z;

    // global var + global var
    r = x + y;

    // global var + const 
    r = x + 8;

    // const + local var
    r = 4 + z;

    // const + global var
    r = 4 + x;

    // const + const 
    r = 4 + 6;
}
