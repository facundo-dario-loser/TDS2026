extern void printInt(int n);

int factorial_iterativo(int n) {
    int acum;

    if (n == 0) {
        return 1;
    }

    acum = 1;

    while (n > 0) {
        acum = acum * n;
        n = n - 1;
    }

    return acum;
}

void main() {
    int x;

    // factorial 3 = 6
    // factorial 6 = 720

    x = factorial_iterativo(factorial_iterativo(3));
    printInt(x);
}
