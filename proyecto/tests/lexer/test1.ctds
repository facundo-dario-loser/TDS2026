int dec(int x) {
    return x - 1;
}

void main() {
    int x;
    boolean y;
    int WHILE;
    int whiletrue;
    int whilefalse;
    int RETURN;
    int iftrue;
    int iffalse;
    int integer;
    boolean bool;
