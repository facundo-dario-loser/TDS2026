    int x, y, z, w, a;
    boolean b, c;
    float t;

    x = 2 + 2;
    y = 4 - 4;
    z = 8 * 8;
    w = 16 / 16;
    a = 32 % 32;

    x = 2 + 8.0;
    y = 2 - 8.0;
    z = 2 * 8.0;
    w = 2 / 8.0;
    a = 2 % 8.0;

    x = 8.0 + 2;
